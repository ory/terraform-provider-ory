# Copy this file to .env and fill in your credentials.
# .env is gitignored and automatically loaded by make targets.

# Required: Workspace credentials
ORY_WORKSPACE_API_KEY=ory_wak_...
ORY_WORKSPACE_ID=...

# Optional: API URL overrides (defaults to production Ory)
# ORY_CONSOLE_API_URL=https://api.console.ory.sh
# ORY_PROJECT_API_URL=https://%s.projects.oryapis.com

# Recommended: Pre-created test project
# When set, tests use this persistent project instead of creating ephemeral ones.
# Required for event stream tests (project UUID must match IAM trust policy ExternalId).
# The project must have keto namespaces and dynamic client registration configured.
ORY_PROJECT_ID=...
ORY_PROJECT_SLUG=...
ORY_PROJECT_API_KEY=ory_pat_...
ORY_PROJECT_ENVIRONMENT=prod

# Optional: Event stream test resources (requires Enterprise plan + AWS setup)
# ORY_EVENT_STREAM_TOPIC_ARN=arn:aws:sns:...
# ORY_EVENT_STREAM_ROLE_ARN=arn:aws:iam::...
