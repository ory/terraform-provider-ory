{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices"
  ],
  "labels": [
    "dependencies"
  ],
  "semanticCommits": "enabled",
  "semanticCommitType": "chore",
  "semanticCommitScope": "deps",
  "packageRules": [
    {
      "description": "Group all Go module updates",
      "matchManagers": [
        "gomod"
      ],
      "groupName": "go modules"
    },
    {
      "description": "Group all GitHub Actions updates",
      "matchManagers": [
        "github-actions"
      ],
      "groupName": "github actions"
    },
    {
      "description": "Group all tool dependency updates",
      "matchFileNames": [
        ".deps/**"
      ],
      "groupName": "tool dependencies"
    },
    {
      "description": "Keep the Ory client OpenAPI spec pin in its own PR so the regenerate workflow runs on its merge",
      "matchDepNames": [
        "ory-client-openapi-spec"
      ],
      "groupName": "ory client openapi spec",
      "versioning": "semver-coerced"
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Track tool versions in .deps yaml files",
      "managerFilePatterns": [
        "/^\\.deps/.*.yaml$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>.*?) depName=(?<depName>[^\\s]+)(?: extractVersion=(?<extractVersion>[^\\s]+))?\\nversion: (?<currentValue>.*)"
      ],
      "extractVersionTemplate": "{{#if extractVersion}}{{{extractVersion}}}{{/if}}"
    }
  ],
  "customDatasources": {
    "ory-sdk-client-spec": {
      "description": "Latest Ory client OpenAPI spec version published to ory/sdk (the file holds one version string)",
      "defaultRegistryUrlTemplate": "https://raw.githubusercontent.com/ory/sdk/master/spec/client/latest",
      "format": "plain"
    }
  }
}
