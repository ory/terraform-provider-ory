{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices"
  ],
  "labels": [
    "dependencies"
  ],
  "semanticCommits": "enabled",
  "semanticCommitType": "chore",
  "semanticCommitScope": "deps",
  "packageRules": [
    {
      "description": "Track Go toolchain version in go.mod",
      "matchManagers": [
        "gomod"
      ],
      "matchDepNames": [
        "go"
      ],
      "semanticCommitType": "fix",
      "semanticCommitScope": "deps"
    },
    {
      "description": "Group all Go module updates",
      "matchManagers": [
        "gomod"
      ],
      "matchDepNames": [
        "!/^go$/"
      ],
      "groupName": "go modules"
    },
    {
      "description": "Group all GitHub Actions updates",
      "matchManagers": [
        "github-actions"
      ],
      "groupName": "github actions"
    },
    {
      "description": "Group all tool dependency updates",
      "matchFileNames": [
        ".deps/**"
      ],
      "groupName": "tool dependencies"
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Track tool versions in .deps yaml files",
      "managerFilePatterns": [
        "/^\\.deps/.*.yaml$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>.*?) depName=(?<depName>[^\\s]+)(?: extractVersion=(?<extractVersion>[^\\s]+))?\\nversion: (?<currentValue>.*)"
      ],
      "extractVersionTemplate": "{{#if extractVersion}}{{{extractVersion}}}{{/if}}"
    }
  ]
}
