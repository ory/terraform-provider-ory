resource "ory_identity_schema" "dedup" {
  schema_id = "[[ .SchemaID ]]"
  schema    = jsonencode({
    "$id": "[[ .AppURL ]]/[[ .ContentID ]].json",
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "Test Schema [[ .ContentID ]]",
    "type": "object",
    "properties": {
      "traits": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "title": "Email",
            "ory.sh/kratos": {
              "credentials": {
                "password": {"identifier": true}
              },
              "verification": {"via": "email"},
              "recovery": {"via": "email"}
            }
          }
        },
        "required": ["email"]
      }
    }
  })
}
