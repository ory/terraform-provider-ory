resource "ory_project" "bootstrap" {
  name        = "[[ .ProjectName ]]"
  environment = "dev"
}

resource "ory_identity_schema" "bootstrap" {
  project_id  = ory_project.bootstrap.id
  schema_id   = "[[ .SchemaID ]]"
  set_default = true
  schema      = jsonencode({
    "$id": "[[ .AppURL ]]/bootstrap-schema.json",
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "Bootstrap Schema [[ .SchemaID ]]",
    "type": "object",
    "properties": {
      "traits": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "title": "Email",
            "ory.sh/kratos": {
              "credentials": {
                "password": {"identifier": true}
              },
              "verification": {"via": "email"},
              "recovery": {"via": "email"}
            }
          }
        },
        "required": ["email"]
      }
    }
  })
}

data "ory_identity_schemas" "bootstrap" {
  project_id = ory_project.bootstrap.id
  depends_on = [ory_identity_schema.bootstrap]
}
