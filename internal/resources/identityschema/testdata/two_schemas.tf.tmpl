resource "ory_identity_schema" "first" {
  schema_id = "[[ .SchemaID1 ]]"
  schema    = jsonencode({
    "$id": "[[ .AppURL ]]/[[ .SchemaID1 ]].json",
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "First Schema [[ .SchemaID1 ]]",
    "type": "object",
    "properties": {
      "traits": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "title": "Email",
            "ory.sh/kratos": {
              "credentials": {
                "password": {"identifier": true}
              },
              "verification": {"via": "email"},
              "recovery": {"via": "email"}
            }
          }
        },
        "required": ["email"]
      }
    }
  })
}

resource "ory_identity_schema" "second" {
  schema_id = "[[ .SchemaID2 ]]"
  schema    = jsonencode({
    "$id": "[[ .AppURL ]]/[[ .SchemaID2 ]].json",
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "Second Schema [[ .SchemaID2 ]]",
    "type": "object",
    "properties": {
      "traits": {
        "type": "object",
        "properties": {
          "username": {
            "type": "string",
            "title": "Username",
            "ory.sh/kratos": {
              "credentials": {
                "password": {"identifier": true}
              }
            }
          }
        },
        "required": ["username"]
      }
    }
  })

  depends_on = [ory_identity_schema.first]
}
