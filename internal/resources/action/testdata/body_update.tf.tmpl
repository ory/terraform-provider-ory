resource "ory_action" "test" {
  flow        = "registration"
  timing      = "after"
  auth_method = "password"
  url         = "[[ .WebhookURL ]]/body-update"
  method      = "POST"
  body        = <<-EOT
    function(ctx) {
      identity: ctx.identity,
      version: [[ .Version ]],
    }
  EOT
}
