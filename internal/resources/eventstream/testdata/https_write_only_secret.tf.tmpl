resource "ory_event_stream" "wo" {
  type                         = "https"
  https_endpoint               = "https://example.com/ory-events"
  https_auth_type              = "bearer"
  https_auth_secret_wo         = "[[ .Secret ]]"
  https_auth_secret_wo_version = "[[ .Version ]]"
  status                       = "paused"
}
