# Reproduces issue #138: during project bootstrap only a workspace API key is
# available. The schema is created with the default (full-credential) provider,
# then looked up through a workspace-only provider alias.
#
# The workspace-only provider has project_slug/project_api_key explicitly empty
# (disabling the Kratos strategy) and the lookup passes no project_id (disabling
# the project-config strategy), so the schema must be found via the workspace
# endpoint (GET /identity-schemas) — exactly the bootstrap path.

resource "ory_identity_schema" "test" {
  schema_id = "[[ .SchemaID ]]"
  schema = jsonencode({
    "$id" : "[[ .AppURL ]]/test-schema-email.json",
    "$schema" : "http://json-schema.org/draft-07/schema#",
    "title" : "Bootstrap Email Schema",
    "type" : "object",
    "properties" : {
      "traits" : {
        "type" : "object",
        "properties" : {
          "email" : {
            "type" : "string",
            "format" : "email",
            "title" : "Email",
            "ory.sh/kratos" : {
              "credentials" : { "password" : { "identifier" : true } },
              "verification" : { "via" : "email" },
              "recovery" : { "via" : "email" }
            }
          }
        },
        "required" : ["email"]
      }
    }
  })
}

# Workspace-only provider: project credentials are explicitly empty, which
# disables the Kratos lookup strategy and forces the workspace endpoint.
provider "ory" {
  alias           = "workspace_only"
  project_slug    = ""
  project_api_key = ""
}

data "ory_identity_schema" "test" {
  provider = ory.workspace_only
  id       = ory_identity_schema.test.id
}
